---
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import EntityArticle from '../../../components/EntityArticle.astro';
import { entities, labels, slug } from '../../../lib/database.mjs';
export function getStaticPaths() {
  return entities.map((entity) => ({ params: { kind: entity.kind, slug: slug(entity.key) }, props: { entity } }));
}
const { entity } = Astro.props;
const headingsByKind = {
  item: [['obtain', '获取与制作'], ['uses', '用于哪些成品？'], ...(entity.quests?.length ? [['quest-uses', '相关专业任务']] : []), ['limits', '其他来源与使用限制']],
  monster: [['locations', '具体地图记录'], ['loot', '拾荒与掉落'], ['combat', '战斗准备']],
  map: [['gather', '官方采集地点记录'], ['pois', '设施与出口'], ['enemies', '怪物记录']],
  quest: [['objective', '所需物品'], ['rewards', '界面显示奖励'], ['steps', '阅读与完成顺序']],
  boss: [['prepare', '入场前检查'], ['unknown', '尚缺的攻略资料']],
  profession: [['start', '从材料到成品'], ['products', '成品与材料配方']],
};
const headings = headingsByKind[entity.kind].map(([slug, text]) => ({ depth: 2, slug, text }));
---
<StarlightPage headings={headings} frontmatter={{ title: entity.name, description: `${entity.name} 的已收录${labels[entity.kind]}资料、来源与相关条目。`, gameVersion: 'EA（Legacy）', versionStatus: '1.0-pending', reviewStatus: '资料条目 · 字段来源分别标注', pagination: false }}>
  <EntityArticle entity={entity} />
</StarlightPage>
