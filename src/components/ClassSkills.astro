---
import skills from '../data/skills.json';
const { cls } = Astro.props;
const data = skills[cls];
const slug = cls.toLowerCase();
const portrait = `${import.meta.env.BASE_URL}img/classes/${slug}_large.png`;
const fmt = (r) => {
  const base = `${r.stat} ${r.v1}${r.unit}`;
  return r.per ? `${base}（每级 +${r.per}${r.unit}）` : base;
};
// 持续时间 / 攻击段数：把英文单位转成中文，仅在字段有值时显示
const zhDur = (v) => (v == null ? '' : String(v).replace(/turns?/i, '回合').replace(/strikes?/i, '段').replace(/\s+/g, ' ').trim());
const durCell = (sk) => {
  const parts = [];
  if (sk.lasts != null) parts.push(zhDur(sk.lasts));
  if (sk.strikes != null) parts.push(zhDur(sk.strikes));
  return parts.join(' · ');
};
---
<div class="nr-class-head">
  <img class="nr-class-portrait" src={portrait} alt={cls} loading="lazy" />
  <div class="nr-class-meta">
    <div class="nr-class-name">{cls}</div>
    <div class="nr-class-sub">技能树 · 数值 = Lv.1 基础值 + 每级增量（可据此推算任意等级）</div>
  </div>
</div>

{data.groups.map((g) => (
  <section class="nr-skill-group">
    <h3>{g.name}</h3>
    <table>
      <thead>
        <tr><th>技能</th><th>类型</th><th>需求</th>{g.skills.some((sk) => sk.lasts != null || sk.strikes != null) ? <th>持续 / 段数</th> : null}<th>基础效果（Lv.1）与每级成长</th></tr>
      </thead>
      <tbody>
        {g.skills.map((sk) => (
          <tr>
            <td><b>{sk.name}</b></td>
            <td>
              {sk.type}
              {sk.mana ? ` · ${sk.mana} MP` : ''}
              {sk.cd ? ` · CD ${sk.cd}` : ''}
              {sk.alignment ? ` · ${sk.alignment}` : ''}
            </td>
            <td>{Array.isArray(sk.requires) ? sk.requires.join(' / ') : (sk.requires || '—')}</td>
            {g.skills.some((x) => x.lasts != null || x.strikes != null) ? <td>{durCell(sk) || '—'}</td> : null}
            <td>{sk.rows && sk.rows.length ? sk.rows.map(fmt).join('；') : (sk.raw20 || []).join('；')}</td>
          </tr>
        ))}
      </tbody>
    </table>
  </section>
))}
