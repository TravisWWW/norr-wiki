---
import live from '../data/bestiary-live.json';
import off10 from '../data/bestiary-1.0.json';
import ea from '../data/bestiary.json';

const base = (import.meta.env.BASE_URL || '/').replace(/\/$/, '') + '/';
const off10ByName = new Map(off10.filter((m) => m && m.name).map((m) => [m.name, m]));
const eaById = new Map(ea.filter((m) => m && m.name).map((m) => [String(m.id), m]));

const monsters = live.enemies.filter((m) => m && m.name);
const types = [...new Set(monsters.map((m) => m.type).filter(Boolean))].sort();
const bioList = [...new Set(monsters.flatMap((m) => (m.biome || '').split(',').map((s) => s.trim())).filter(Boolean))].sort();

function parseRange(s) { const m = String(s || '').match(/(\d+)\s*-\s*(\d+)/); return m ? [+m[1], +m[2]] : [null, null]; }

const cards = monsters.map((m) => {
  const o = off10ByName.get(m.name);
  const e = eaById.get(String(m.id));
  const levelRange = m.levelRange || (o && o.levelRange) || (e && e.levelRange) || '';
  const levelSource = m.levelRange ? 'live' : (o && o.levelRange) ? 'official' : (e && e.levelRange) ? 'ea' : '';
  const scavLive = (m.scavenging || []).map((s) => ({ name: s.name, res: s.res, pct: s.pct }));
  const scavFallback = ((o && o.scavenging) || (e && e.scavenging) || []).map((n) => ({ name: n, res: '', pct: '' }));
  const scav = scavLive.length ? scavLive : scavFallback;
  const scavSource = scavLive.length ? 'live' : scavFallback.length ? 'fallback' : '';
  const drops = (m.drops || []).map((s) => ({ name: s.name, res: s.res, pct: s.pct }));
  const [lo, hi] = parseRange(levelRange);
  return {
    id: m.id, name: m.name, type: m.type || '', biome: m.biome || '', tab: m.tab || 'other',
    levelRange, levelSource, lo: lo == null ? '' : lo, hi: hi == null ? '' : hi,
    health: m.health || '', defense: m.defense || '', resistance: m.resistance || '',
    alignment: m.alignment || '', specials: m.specials || '',
    recorded: !!m.recorded, lore: m.lore || '',
    scav, scavSource, drops,
    skills: (m.skills || []).map((s) => ({ name: s.name, level: s.level })),
    stats: m.stats || null,
    icon: `${base}img/enemies/enemy_${m.id}.gif`,
    bg: m.bg ? `${base}img/battlemaps/${m.bg}` : '',
    hasIcon: ![155, 253].includes(m.id),
  };
});
const recordedCount = cards.filter((c) => c.recorded).length;
const withLore = cards.filter((c) => c.lore).length;
const withStats = cards.filter((c) => c.stats).length;
---
<div class="bl-app">
  <aside class="bl-side" id="bl-side">
    <div class="bl-side-head">
      <span class="bl-side-title">筛选</span>
      <button type="button" class="bl-reset" id="bl-reset">重置</button>
    </div>
    <label class="bl-field">
      <span>搜索</span>
      <input id="bl-q" type="search" placeholder="怪物名 / 类型 / 群系 / 掉落…" />
    </label>
    <div class="bl-field"><span>类别</span>
      <div class="bl-chips" id="bl-tab">
        <button type="button" class="bl-chip is-on" data-val="">全部</button>
        <button type="button" class="bl-chip" data-val="normal">普通</button>
        <button type="button" class="bl-chip" data-val="boss">Boss</button>
        <button type="button" class="bl-chip" data-val="overlord">Overlord</button>
        <button type="button" class="bl-chip" data-val="other">其他</button>
      </div>
    </div>
    <label class="bl-field"><span>类型</span>
      <select id="bl-type"><option value="">全部类型</option>{types.map((t) => <option value={t}>{t}</option>)}</select>
    </label>
    <label class="bl-field"><span>群系</span>
      <select id="bl-biome"><option value="">全部群系</option>{bioList.map((b) => <option value={b}>{b}</option>)}</select>
    </label>
    <label class="bl-field"><span>等级</span>
      <select id="bl-lvl">
        <option value="">全部等级</option><option value="1-9">Lv1–9</option><option value="10-19">Lv10–19</option>
        <option value="20-29">Lv20–29</option><option value="30-39">Lv30–39</option><option value="40-999">Lv40+</option>
      </select>
    </label>
    <label class="bl-switch"><input type="checkbox" id="bl-rec" /><span>只看已记录</span></label>
    <label class="bl-field"><span>排序</span>
      <select id="bl-sort">
        <option value="id">图鉴编号</option>
        <option value="name">名称 A→Z</option>
        <option value="lvl">等级（低→高）</option>
        <option value="lvl-desc">等级（高→低）</option>
        <option value="rec">已记录优先</option>
      </select>
    </label>
    <div class="bl-side-foot">
      <div class="bl-stat"><b>{cards.length}</b><span>总条目</span></div>
      <div class="bl-stat"><b>{recordedCount}</b><span>已记录</span></div>
      <div class="bl-stat"><b>{withLore}</b><span>有故事</span></div>
      <div class="bl-stat"><b>{withStats}</b><span>有属性</span></div>
    </div>
  </aside>

  <section class="bl-main">
    <div class="bl-topbar">
      <button type="button" class="bl-filter-toggle" id="bl-filter-toggle" aria-expanded="false">筛选 / 排序</button>
      <span class="bl-count" id="bl-count">{cards.length} 种</span>
      <span class="bl-hint">点卡片查看详情</span>
    </div>
    <div class="bl-grid" id="bl-grid">
      {cards.map((c) => (
        <button type="button" class="bl-card" data-id={c.id} data-name={(c.name || '').toLowerCase()} data-type={c.type} data-biome={c.biome} data-tab={c.tab} data-rec={c.recorded ? 1 : 0} data-lo={c.lo} data-hi={c.hi} aria-haspopup="dialog">
          <span class="bl-thumb">
            {c.hasIcon ? <img src={c.icon} alt={c.name} loading="lazy" width="64" height="64" /> : <span class="bl-noimg">?</span>}
            {c.tab === 'boss' ? <span class="bl-badge bl-badge-boss">BOSS</span> : null}
            {c.tab === 'overlord' ? <span class="bl-badge bl-badge-over">OVERLORD</span> : null}
            {c.tab === 'other' ? <span class="bl-badge bl-badge-other">其他</span> : null}
          </span>
          <span class="bl-cname">{c.name}</span>
          <span class="bl-cmeta">{c.type || '未知'}{c.levelRange ? <> · Lv{c.levelRange}</> : null}</span>
          <span class="bl-cfoot">
            {c.recorded ? <span class="bl-dot bl-dot-on" title="已记录">已记录</span> : <span class="bl-dot" title="未记录">未记录</span>}
            {c.stats ? <span class="bl-mini" title="已解锁数值属性">属性</span> : null}
            {c.skills.length ? <span class="bl-mini" title="已解锁技能">技能</span> : null}
          </span>
        </button>
      ))}
    </div>
    <p class="bl-empty" id="bl-empty" hidden>没有符合条件的怪物。</p>
    <p class="bl-note">共 <b>{cards.length}</b> 种（1.0 正式服游戏内 Inspect 实测）。<span class="bl-src">†</span> 表示该字段来自官方 1.0 Wiki / EA 清单（游戏内尚未记录）。</p>
  </section>
</div>

<div class="bl-modal" id="bl-modal" hidden>
  <div class="bl-backdrop" data-close></div>
  <div class="bl-dialog" role="dialog" aria-modal="true" aria-labelledby="bl-dname">
    <div class="bl-dialog-head">
      <h3 id="bl-dname">—</h3>
      <button type="button" class="bl-close" id="bl-close" aria-label="关闭">✕</button>
    </div>
    <div class="bl-tabs" id="bl-tabs">
      <button type="button" class="bl-tab is-on" data-tab="profile">图鉴</button>
      <button type="button" class="bl-tab" data-tab="skills">技能</button>
      <button type="button" class="bl-tab" data-tab="stats">属性</button>
    </div>
    <div class="bl-dialog-body" id="bl-body"></div>
  </div>
</div>

<script type="application/json" id="bl-data" set:html={JSON.stringify({ base, cards })} />

<script>
  const payload = JSON.parse(document.getElementById('bl-data').textContent);
  const data = payload.cards, base2 = payload.base;
  const byId = new Map(data.map((c) => [String(c.id), c]));
  const grid = document.getElementById('bl-grid');
  const cards = [...grid.querySelectorAll('.bl-card')];
  const count = document.getElementById('bl-count');
  const empty = document.getElementById('bl-empty');
  const q = document.getElementById('bl-q');
  const type = document.getElementById('bl-type');
  const biome = document.getElementById('bl-biome');
  const lvl = document.getElementById('bl-lvl');
  const rec = document.getElementById('bl-rec');
  const sortSel = document.getElementById('bl-sort');
  const tabWrap = document.getElementById('bl-tab');
  let curTab = '';

  tabWrap.addEventListener('click', (e) => {
    const b = e.target.closest('.bl-chip'); if (!b) return;
    [...tabWrap.children].forEach((x) => x.classList.toggle('is-on', x === b));
    curTab = b.dataset.val; apply();
  });

  function overlap(lo, hi, range) { if (!range) return true; if (lo === '' || hi === '') return false; const [a, b] = range.split('-').map(Number); return +lo <= b && +hi >= a; }

  function apply() {
    const s = (q.value || '').toLowerCase().trim();
    const t = type.value, b = biome.value, l = lvl.value;
    let n = 0;
    for (const r of cards) {
      const ok = (!s || r.textContent.toLowerCase().includes(s))
        && (!t || r.dataset.type === t)
        && (!b || (r.dataset.biome || '').includes(b))
        && (!curTab || r.dataset.tab === curTab)
        && (!rec.checked || r.dataset.rec === '1')
        && overlap(r.dataset.lo, r.dataset.hi, l);
      r.hidden = !ok;
      if (ok) n++;
    }
    count.textContent = n + ' 种';
    empty.hidden = n !== 0;
  }

  function sort() {
    const v = sortSel.value;
    const arr = cards.slice().sort((a, b) => {
      if (v === 'name') return a.dataset.name.localeCompare(b.dataset.name);
      if (v === 'lvl' || v === 'lvl-desc') {
        const av = a.dataset.lo === '' ? 9999 : +a.dataset.lo, bv = b.dataset.lo === '' ? 9999 : +b.dataset.lo;
        return v === 'lvl' ? av - bv : bv - av;
      }
      if (v === 'rec') return (b.dataset.rec === '1' ? 1 : 0) - (a.dataset.rec === '1' ? 1 : 0) || (+a.dataset.id) - (+b.dataset.id);
      return (+a.dataset.id) - (+b.dataset.id);
    });
    for (const r of arr) grid.appendChild(r);
  }

  q.addEventListener('input', apply);
  type.addEventListener('change', apply);
  biome.addEventListener('change', apply);
  lvl.addEventListener('change', apply);
  rec.addEventListener('change', apply);
  sortSel.addEventListener('change', () => { sort(); });

  document.getElementById('bl-reset').addEventListener('click', () => {
    q.value = ''; type.value = ''; biome.value = ''; lvl.value = ''; rec.checked = false; sortSel.value = 'id';
    curTab = ''; [...tabWrap.children].forEach((x) => x.classList.toggle('is-on', x.dataset.val === ''));
    sort(); apply();
  });

  const modal = document.getElementById('bl-modal');
  const body = document.getElementById('bl-body');
  const dname = document.getElementById('bl-dname');
  const tabs = document.getElementById('bl-tabs');
  let cur = null, curTabName = 'profile';
  const esc = (s) => String(s == null ? '' : s).replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c]));
  const lvlMark = (src) => src === 'official' ? '<span class="bl-src" title="来自官方 1.0 Wiki">†</span>' : src === 'ea' ? '<span class="bl-src" title="来自 EA 清单">‡</span>' : '';
  const labelCls = (v) => v === 'Low' ? 'set' : v === 'Medium' ? 'mystical' : v === 'High' ? 'relic' : 'normal';
  const labelZh = (v) => ({ Low: '低', Medium: '中', High: '高' }[v] || v);
  const labelHtml = (v) => v ? `<span class="bl-lbl bl-lbl-${labelCls(v)}">${esc(labelZh(v))}</span>` : '<span class="bl-muted">未记录</span>';

  function lootHtml(arr, src) {
    if (!arr.length) return '<p class="bl-muted">未记录。</p>';
    const items = arr.map((x) => {
      const img = x.res ? `<img src="${base2}img/items/res_${esc(x.res)}.gif" alt="" width="24" height="24" loading="lazy" />` : '<span class="bl-itemicon bl-itemicon-empty"></span>';
      return `<span class="bl-item" title="${esc(x.name)}">${img}<span class="bl-itemname">${esc(x.name)}</span>${x.pct ? `<em>${esc(x.pct)}</em>` : ''}</span>`;
    }).join('');
    const note = src === 'fallback' ? '<p class="bl-muted">拾荒类别来自官方 1.0 Wiki / EA 清单（无概率）。</p>' : '';
    return `<div class="bl-items">${items}</div>${note}`;
  }

  function renderTab() {
    const c = cur; if (!c) return;
    if (curTabName === 'skills') {
      body.innerHTML = c.skills.length
        ? `<div class="bl-skillgrid">${c.skills.map((s) => `<span class="bl-skill">${esc(s.name)} <em>Lv${s.level}</em></span>`).join('')}</div>`
        : `<p class="bl-locked">技能未解锁 —— 击杀 <b>10 次</b>后显示。</p>`;
      return;
    }
    if (curTabName === 'stats') {
      body.innerHTML = c.stats
        ? `<p class="bl-muted">基础值；遭遇等级 2–10 按游戏内公式换算。</p><div class="bl-statgrid">${Object.entries(c.stats).map(([k, v]) => `<span class="bl-stat-chip"><span>${esc(k)}</span><b>${v}</b></span>`).join('')}</div>`
        : `<p class="bl-locked">数值属性未解锁 —— 击杀 <b>20 次</b>后显示。</p>`;
      return;
    }
    const loreBg = c.bg ? ` style="background-image:linear-gradient(90deg, rgba(10,10,12,.92) 0%, rgba(10,10,12,.72) 55%, rgba(10,10,12,.45) 100%), url('${c.bg}')"` : '';
    body.innerHTML = `
      <div class="bl-lore${c.bg ? ' has-bg' : ''}"${loreBg}>
        <div class="bl-lore-art">${c.hasIcon ? `<img src="${c.icon}" alt="${esc(c.name)}" width="96" height="96" />` : '<span class="bl-noimg">?</span>'}</div>
        <div class="bl-lore-body">
          <h2 class="bl-lore-name">${esc(c.name)}</h2>
          <div class="bl-lore-type">${esc(c.type || '未知类型')}</div>
          <div class="bl-lore-biome">${esc(c.biome || '未知群系')}</div>
          <hr class="bl-lore-hr" />
          <p class="bl-lore-text">${c.lore ? esc(c.lore) : '该条目暂无背景故事文本。'}</p>
        </div>
      </div>
      <div class="bl-info">
        <div class="bl-info-col">
          <div class="bl-info-row"><span class="bl-info-k">🎖️ 等级</span><span class="bl-info-v">${c.levelRange ? esc(c.levelRange) : '<span class="bl-muted">未记录</span>'}${lvlMark(c.levelSource)}</span></div>
          <div class="bl-info-row"><span class="bl-info-k">🌗 阵营</span><span class="bl-info-v">${c.alignment ? esc(c.alignment) : '<span class="bl-muted">未记录</span>'}</span></div>
          <div class="bl-info-row"><span class="bl-info-k">✨ 特殊能力</span><span class="bl-info-v">${c.specials ? esc(c.specials === '-' ? '—' : c.specials) : '<span class="bl-muted">未记录</span>'}</span></div>
        </div>
        <div class="bl-info-col">
          <div class="bl-info-row"><span class="bl-info-k">❤️ 生命</span><span class="bl-info-v">${labelHtml(c.health)}</span></div>
          <div class="bl-info-row"><span class="bl-info-k">🛡️ 防御</span><span class="bl-info-v">${labelHtml(c.defense)}</span></div>
          <div class="bl-info-row"><span class="bl-info-k">🌀 抗性</span><span class="bl-info-v">${labelHtml(c.resistance)}</span></div>
        </div>
      </div>
      <div class="bl-lootrow">
        <div class="bl-loothead">🔪 拾荒掉落</div>
        <div class="bl-lootbody">${lootHtml(c.scav, c.scavSource)}</div>
      </div>
      <div class="bl-lootrow">
        <div class="bl-loothead">📦 掉落</div>
        <div class="bl-lootbody">${lootHtml(c.drops, 'live')}</div>
      </div>
      <p class="bl-muted bl-tiernote">ℹ️ 拾荒材料与掉落的品质 / 阶级会随敌人等级在 Tier 1–2 之间变化。</p>
      <p class="bl-muted">${c.recorded ? '已记录：等级、防护与掉落已解锁。' : '未记录：击杀 1 次后解锁等级、防护与掉落。'}</p>`;
  }

  function open(id) {
    const c = byId.get(String(id)); if (!c) return;
    cur = c; curTabName = 'profile';
    [...tabs.children].forEach((t) => t.classList.toggle('is-on', t.dataset.tab === 'profile'));
    dname.innerHTML = `${esc(c.name)}${c.tab === 'boss' ? ' <span class="bl-badge bl-badge-boss">BOSS</span>' : ''}${c.tab === 'overlord' ? ' <span class="bl-badge bl-badge-over">OVERLORD</span>' : ''}`;
    renderTab();
    modal.hidden = false;
    document.body.style.overflow = 'hidden';
    document.getElementById('bl-close').focus();
  }
  function close() { modal.hidden = true; document.body.style.overflow = ''; cur = null; }

  tabs.addEventListener('click', (e) => {
    const t = e.target.closest('.bl-tab'); if (!t) return;
    curTabName = t.dataset.tab;
    [...tabs.children].forEach((x) => x.classList.toggle('is-on', x === t));
    renderTab();
  });
  grid.addEventListener('click', (e) => { const c = e.target.closest('.bl-card'); if (c) open(c.dataset.id); });
  modal.addEventListener('click', (e) => { if (e.target.closest('[data-close]')) close(); });
  document.getElementById('bl-close').addEventListener('click', close);
  document.addEventListener('keydown', (e) => { if (e.key === 'Escape' && !modal.hidden) close(); });

  const ft = document.getElementById('bl-filter-toggle');
  ft.addEventListener('click', () => {
    const side = document.getElementById('bl-side');
    const on = side.classList.toggle('is-open');
    ft.setAttribute('aria-expanded', on ? 'true' : 'false');
  });

  const params = new URLSearchParams(location.search);
  if (params.get('q')) q.value = params.get('q');
  if (params.get('mon')) q.value = params.get('mon');
  if (params.get('type')) type.value = params.get('type');
  if (params.get('biome')) biome.value = params.get('biome');
  if (params.get('tab')) { curTab = params.get('tab'); [...tabWrap.children].forEach((x) => x.classList.toggle('is-on', x.dataset.val === curTab)); }
  apply();
  if (params.get('mon')) {
    const hit = cards.find((r) => r.dataset.name === params.get('mon').toLowerCase());
    if (hit) open(hit.dataset.id);
  }
</script>

<style is:global>
  /* hidden 属性优先：显式 display 会覆盖 [hidden]，需显式复位 */
  .bl-card[hidden], .bl-modal[hidden], .bl-empty[hidden] { display: none !important; }
  .bl-app { display: grid; grid-template-columns: 230px minmax(0, 1fr); gap: 1.1rem; align-items: start; margin: 1rem 0 1.5rem; }
  .bl-side { position: sticky; top: 4.5rem; border: 1px solid var(--nr-line); border-radius: 10px; background: linear-gradient(180deg, var(--nr-panel-2), var(--nr-panel)); padding: .85rem; display: flex; flex-direction: column; gap: .7rem; box-shadow: inset 0 1px 0 rgba(238,187,102,.05); }
  .bl-side-head { display: flex; align-items: center; justify-content: space-between; }
  .bl-side-title { font-family: var(--nr-serif); color: var(--nr-text); font-weight: 600; letter-spacing: .5px; }
  .bl-reset { background: none; border: 1px solid var(--nr-hair); color: var(--nr-dim); border-radius: 5px; font-size: .72rem; padding: .12rem .45rem; cursor: pointer; }
  .bl-reset:hover { color: var(--nr-gold); border-color: var(--nr-gold-dim); }
  .bl-field { display: flex; flex-direction: column; gap: .3rem; font-size: .78rem; color: var(--nr-dim); }
  .bl-field input, .bl-field select { width: 100%; padding: .38rem .5rem; border-radius: 6px; border: 1px solid var(--nr-hair); background: #17171c; color: var(--nr-text-soft); font-size: .84rem; }
  .bl-field input:focus, .bl-field select:focus { outline: none; border-color: var(--nr-gold-dim); }
  .bl-chips { display: flex; flex-wrap: wrap; gap: .3rem; }
  .bl-chip { border: 1px solid var(--nr-hair); background: #17171c; color: var(--nr-text-soft); border-radius: 999px; font-size: .74rem; padding: .18rem .55rem; cursor: pointer; }
  .bl-chip:hover { border-color: var(--nr-gold-dim); color: var(--nr-gold); }
  .bl-chip.is-on { background: linear-gradient(180deg, var(--nr-gold-2), var(--nr-gold)); color: #14151a; border-color: #8a6a2f; font-weight: 600; }
  .bl-switch { display: flex; align-items: center; gap: .45rem; font-size: .82rem; color: var(--nr-text-soft); cursor: pointer; }
  .bl-side-foot { display: grid; grid-template-columns: 1fr 1fr; gap: .4rem; border-top: 1px solid var(--nr-hair); padding-top: .6rem; }
  .bl-stat { display: flex; flex-direction: column; align-items: center; background: #17171c; border: 1px solid var(--nr-hair); border-radius: 6px; padding: .3rem; }
  .bl-stat b { color: var(--nr-gold); font-size: 1.05rem; }
  .bl-stat span { color: var(--nr-dim); font-size: .68rem; }
  .bl-topbar { display: flex; align-items: center; gap: .7rem; margin-bottom: .7rem; }
  .bl-filter-toggle { display: none; border: 1px solid var(--nr-hair); background: #17171c; color: var(--nr-text-soft); border-radius: 6px; padding: .35rem .7rem; font-size: .84rem; cursor: pointer; }
  .bl-count { color: var(--nr-gold); font-weight: 600; font-size: .9rem; }
