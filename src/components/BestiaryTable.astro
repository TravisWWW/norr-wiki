---
import bestiary from '../data/bestiary.json';
import mapdb from '../data/maps.json';
const monsters = bestiary.filter((m) => m && m.name);
const mapsArr = Object.values(mapdb.maps).filter((m) => m && m.name);
const mapBiomes = new Set(mapsArr.map((m) => m.biome).filter(Boolean));
// 怪物名 -> 实际出现的地图（来自 maps.json 的 m 字段，而非 biome 反推）
const monsterMaps = {};
for (const mp of mapsArr) {
  for (const n of (mp.m || [])) {
    (monsterMaps[n] = monsterMaps[n] || []).push({ name: mp.name, level: mp.level || '' });
  }
}
const types = [...new Set(monsters.map((m) => m.type).filter(Boolean))].sort();
const biomes = [...new Set(monsters.flatMap((m) => m.biomes || []).filter(Boolean))].sort();
const levels = [
  { v: '1-9', label: 'Lv1–9' }, { v: '10-19', label: 'Lv10–19' }, { v: '20-29', label: 'Lv20–29' },
  { v: '30-39', label: 'Lv30–39' }, { v: '40-99', label: 'Lv40+' },
];
const base = import.meta.env.BASE_URL.replace(/\/$/, '') + '/';
function parseRange(s) { const m = String(s || '').match(/(\d+)\s*-\s*(\d+)/); return m ? [+m[1], +m[2]] : [null, null]; }
const rows = monsters.map((m) => {
  const [lo, hi] = parseRange(m.levelRange);
  return {
    id: m.id, name: m.name, type: m.type || '', levelRange: m.levelRange || '',
    lo: lo == null ? '' : lo, hi: hi == null ? '' : hi,
    wide: (lo != null && hi != null && hi - lo >= 50) ? 1 : 0,
    biomes: (m.biomes || []), scavenging: (m.scavenging || []),
    maps: monsterMaps[m.name] || [],
  };
});
const wideCount = rows.filter((r) => r.wide).length;
const withMap = rows.filter((r) => r.maps.length).length;
---
<div class="nr-toolbar">
  <input id="be-q" type="search" placeholder="搜索：怪物名 / 生物群系 / 出现地图 / 掉落…" />
  <select id="be-type"><option value="">全部类型</option>{types.map((t) => <option value={t}>{t}</option>)}</select>
  <select id="be-biome"><option value="">全部生物群系</option>{biomes.map((b) => <option value={b}>{b}</option>)}</select>
  <select id="be-lvl"><option value="">全部等级</option>{levels.map((l) => <option value={l.v}>{l.label}</option>)}</select>
  <label class="nr-check"><input type="checkbox" id="be-wide" /> 只看特殊（宽等级）</label>
  <span class="nr-count" id="be-count"></span>
</div>
<table id="be-table">
  <thead>
    <tr><th>名称</th><th>类型</th><th>等级</th><th>生物群系</th><th>出现地图</th><th>拾荒掉落</th></tr>
  </thead>
  <tbody>
    {rows.map((m) => (
      <>
        <tr class="be-row" data-name={(m.name || '').toLowerCase()} data-type={m.type} data-biome={m.biomes.join('、')} data-lo={m.lo} data-hi={m.hi} data-wide={m.wide} data-maps={m.maps.map((x) => x.name).join('、')}>
          <td><button type="button" class="be-name" aria-expanded="false">{m.name}</button>{m.wide ? <span class="be-tag">特殊</span> : null}</td>
          <td>{m.type || '—'}</td>
          <td>{m.levelRange || '—'}</td>
          <td>{m.biomes.length ? m.biomes.map((b) => (mapBiomes.has(b) ? <a href={`${base}world/maps/?biome=${encodeURIComponent(b)}`}>{b}</a> : <span class="be-plain" title="该生物群系暂无对应地图记录">{b}</span>)) : '—'}</td>
          <td>{m.maps.length === 0 ? <span class="be-plain">—</span> : (m.maps.length <= 3
            ? m.maps.map((x) => <a href={`${base}world/maps/?q=${encodeURIComponent(x.name)}`}>{x.name}</a>)
            : <><a href={`${base}world/maps/?q=${encodeURIComponent(m.maps[0].name)}`}>{m.maps[0].name}</a><span class="be-plain"> 等 {m.maps.length} 张</span></>)}</td>
          <td>{m.scavenging.length ? m.scavenging.join('、') : '—'}</td>
        </tr>
        <tr class="be-detail" hidden>
          <td colspan="6">
            <div class="be-dgrid">
              <div><b>类型</b>：{m.type || '—'}</div>
              <div><b>等级范围</b>：{m.levelRange || '—'}{m.wide ? <span class="be-tag">范围很宽，可能是跨区 / 特殊敌人</span> : null}</div>
              <div><b>生物群系</b>：{m.biomes.length ? m.biomes.map((b) => (mapBiomes.has(b) ? <a href={`${base}world/maps/?biome=${encodeURIComponent(b)}`}>{b}</a> : <span class="be-plain">{b}</span>)) : '—'}</div>
              <div><b>出现地图（{m.maps.length}）</b>：{m.maps.length ? m.maps.map((x) => <a href={`${base}world/maps/?q=${encodeURIComponent(x.name)}`}>{x.name}</a>) : <span class="be-plain">暂无地图记录（仅按生物群系收录）</span>}</div>
              <div><b>拾荒掉落</b>：{m.scavenging.length ? m.scavenging.map((s) => <span class="be-chip">{s}</span>) : '—'}</div>
            </div>
          </td>
        </tr>
      </>
    ))}
  </tbody>
</table>
<p class="nr-note">共 {monsters.length} 种；其中 <b>{wideCount}</b> 种等级范围较宽（≥50，标记为「特殊」），<b>{withMap}</b> 种有具体出现地图记录。<b>生物群系</b>是怪物所属的区域类型，<b>出现地图</b>才是它实际刷新的地图（来自地图数据，非按群系反推）。点怪物名展开详情；点地图名跳到该地图。</p>

<script>
  const q = document.getElementById('be-q');
  const type = document.getElementById('be-type');
  const biome = document.getElementById('be-biome');
  const lvl = document.getElementById('be-lvl');
  const wide = document.getElementById('be-wide');
  const tbody = document.querySelector('#be-table tbody');
  const rows = [...tbody.querySelectorAll('.be-row')];
  const count = document.getElementById('be-count');
  function overlap(lo, hi, range) { if (!range) return true; if (lo === '' || hi === '') return false; const [a, b] = range.split('-').map(Number); return +lo <= b && +hi >= a; }
  function apply() {
    const s = (q.value || '').toLowerCase().trim();
    const t = type.value, b = biome.value, l = lvl.value;
    let n = 0;
    for (const r of rows) {
      const ok = (!s || r.textContent.toLowerCase().includes(s))
        && (!t || r.dataset.type === t)
        && (!b || (r.dataset.biome || '').includes(b))
        && (!wide.checked || r.dataset.wide === '1')
        && overlap(r.dataset.lo, r.dataset.hi, l);
      r.style.display = ok ? '' : 'none';
      const d = r.nextElementSibling;
      if (d && d.classList.contains('be-detail') && !ok) d.hidden = true;
      if (ok) n++;
    }
    count.textContent = n + ' 种';
  }
  tbody.addEventListener('click', (e) => {
    const btn = e.target.closest('.be-name');
    if (!btn) return;
    const row = btn.closest('.be-row');
    const d = row.nextElementSibling;
    if (!d || !d.classList.contains('be-detail')) return;
    d.hidden = !d.hidden;
    btn.setAttribute('aria-expanded', d.hidden ? 'false' : 'true');
  });
  q.addEventListener('input', apply);
  type.addEventListener('change', apply);
  biome.addEventListener('change', apply);
  lvl.addEventListener('change', apply);
  wide.addEventListener('change', apply);
  const params = new URLSearchParams(location.search);
  if (params.get('q')) q.value = params.get('q');
  if (params.get('mon')) q.value = params.get('mon');
  if (params.get('type')) type.value = params.get('type');
  if (params.get('biome')) biome.value = params.get('biome');
  if (params.get('lvl')) lvl.value = params.get('lvl');
  if (params.get('wide') === '1') wide.checked = true;
  apply();
  // 深链到具体怪物时自动展开该怪详情
  if (params.get('mon')) {
    const target = params.get('mon').toLowerCase();
    const hit = rows.find((r) => r.dataset.name === target);
    if (hit) { const d = hit.nextElementSibling; if (d && d.classList.contains('be-detail')) { d.hidden = false; const b2 = hit.querySelector('.be-name'); if (b2) b2.setAttribute('aria-expanded', 'true'); } }
  }
</script>

<style>
  .be-tag { font-size: .7rem; color: var(--nr-gold); border: 1px solid var(--nr-gold-dim); border-radius: 3px; padding: 0 .3rem; margin-left: .3rem; }
  .nr-note { color: var(--nr-dim); font-size: .8rem; margin-top: .5rem; }
  #be-table td a, #be-table td .be-plain { margin-right: .35rem; }
  .be-plain { color: var(--nr-dim); }
  .be-name { background: none; border: 0; color: var(--nr-text); font: inherit; font-weight: 600; cursor: pointer; padding: 0; text-align: left; }
  .be-name:hover { color: var(--nr-gold); }
  .be-detail td { background: var(--nr-bg); }
  .be-dgrid { display: grid; gap: .3rem; font-size: .86rem; }
  .be-chip { border: 1px solid var(--nr-hair); background: var(--nr-panel-2); color: var(--nr-text-soft); border-radius: 4px; padding: .05rem .4rem; font-size: .78rem; margin: 0 .25rem .25rem 0; display: inline-block; }
</style>
