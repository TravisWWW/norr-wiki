---
import bestiary from '../data/bestiary-1.0.json';
const monsters = bestiary.filter((m) => m && m.name);
const types = [...new Set(monsters.map((m) => m.type).filter(Boolean))].sort();
const biomes = [...new Set(monsters.map((m) => m.biome).filter(Boolean))].sort();
const levels = [
  { v: '1-9', label: 'Lv1–9' }, { v: '10-19', label: 'Lv10–19' }, { v: '20-29', label: 'Lv20–29' },
  { v: '30-39', label: 'Lv30–39' }, { v: '40-99', label: 'Lv40+' },
];
function parseRange(s) { const m = String(s || '').match(/(\d+)\s*-\s*(\d+)/); return m ? [+m[1], +m[2]] : [null, null]; }
const rows = monsters.map((m) => {
  const [lo, hi] = parseRange(m.levelRange);
  return {
    name: m.name, type: m.type || '', levelRange: m.levelRange || '',
    lo: lo == null ? '' : lo, hi: hi == null ? '' : hi,
    wide: (lo != null && hi != null && hi - lo >= 50) ? 1 : 0,
    biome: m.biome || '', scavenging: (m.scavenging || []),
  };
});
const wideCount = rows.filter((r) => r.wide).length;
---
<div class="nr-toolbar">
  <input id="be10-q" type="search" placeholder="搜索：怪物名 / 类型 / 生物群系 / 拾荒掉落…" />
  <select id="be10-type"><option value="">全部类型</option>{types.map((t) => <option value={t}>{t}</option>)}</select>
  <select id="be10-biome"><option value="">全部生物群系</option>{biomes.map((b) => <option value={b}>{b}</option>)}</select>
  <select id="be10-lvl"><option value="">全部等级</option>{levels.map((l) => <option value={l.v}>{l.label}</option>)}</select>
  <label class="nr-check"><input type="checkbox" id="be10-wide" /> 只看特殊（宽等级）</label>
  <span class="nr-count" id="be10-count"></span>
</div>
<table id="be10-table">
  <thead>
    <tr><th>名称</th><th>类型</th><th>等级</th><th>生物群系</th><th>拾荒掉落</th></tr>
  </thead>
  <tbody>
    {rows.map((m) => (
      <tr class="be10-row" data-name={(m.name || '').toLowerCase()} data-type={m.type} data-biome={m.biome} data-lo={m.lo} data-hi={m.hi} data-wide={m.wide}>
        <td>{m.name}{m.wide ? <span class="be10-tag">特殊</span> : null}</td>
        <td>{m.type || '—'}</td>
        <td>{m.levelRange || '—'}</td>
        <td>{m.biome || '—'}</td>
        <td>{m.scavenging.length ? m.scavenging.join('、') : '—'}</td>
      </tr>
    ))}
  </tbody>
</table>
<p class="nr-note">共 {monsters.length} 种（官方 1.0 Wiki Enemies 页）；其中 <b>{wideCount}</b> 种等级范围较宽（≥50，标记为「特殊」）。</p>

<script>
  const q = document.getElementById('be10-q');
  const type = document.getElementById('be10-type');
  const biome = document.getElementById('be10-biome');
  const lvl = document.getElementById('be10-lvl');
  const wide = document.getElementById('be10-wide');
  const tbody = document.querySelector('#be10-table tbody');
  const rows = [...tbody.querySelectorAll('.be10-row')];
  const count = document.getElementById('be10-count');
  function overlap(lo, hi, range) { if (!range) return true; if (lo === '' || hi === '') return false; const [a, b] = range.split('-').map(Number); return +lo <= b && +hi >= a; }
  function apply() {
    const s = (q.value || '').toLowerCase().trim();
    const t = type.value, b = biome.value, l = lvl.value;
    let n = 0;
    for (const r of rows) {
      const ok = (!s || r.textContent.toLowerCase().includes(s))
        && (!t || r.dataset.type === t)
        && (!b || r.dataset.biome === b)
        && (!wide.checked || r.dataset.wide === '1')
        && overlap(r.dataset.lo, r.dataset.hi, l);
      r.style.display = ok ? '' : 'none';
      if (ok) n++;
    }
    count.textContent = n + ' 种';
  }
  q.addEventListener('input', apply);
  type.addEventListener('change', apply);
  biome.addEventListener('change', apply);
  lvl.addEventListener('change', apply);
  wide.addEventListener('change', apply);
  const params = new URLSearchParams(location.search);
  if (params.get('q')) q.value = params.get('q');
  if (params.get('mon')) q.value = params.get('mon');
  if (params.get('type')) type.value = params.get('type');
  if (params.get('biome')) biome.value = params.get('biome');
  if (params.get('lvl')) lvl.value = params.get('lvl');
  if (params.get('wide') === '1') wide.checked = true;
  apply();
</script>

<style>
  .be10-tag { font-size: .7rem; color: var(--nr-gold); border: 1px solid var(--nr-gold-dim); border-radius: 3px; padding: 0 .3rem; margin-left: .3rem; }
  .nr-note { color: var(--nr-dim); font-size: .8rem; margin-top: .5rem; }
</style>